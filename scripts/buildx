#!/bin/bash

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [ -f "$DIR/ci/frontend-build" ]; then
  echo "Running frontend build..."
  . "$DIR/ci/frontend-build"
else
  echo "WARNING: Frontend build script '$DIR/ci/frontend-build' not found. Skipping."
fi

cd "${DIR}/../.."

echo "Building Docker image (without pushing)..."
echo "Using Dockerfile: docker/Dockerfile"
echo "Tags: $BUILD_TAG"
echo "Platforms: $BUILD_PLATFORM"

docker buildx build -f docker/Dockerfile $BUILD_TAG --platform $BUILD_PLATFORM .

echo "Docker image build step completed."